# ── Primary LLM: AgentRouter (Anthropic SDK Compatible) ────────────────────
AGENTROUTER_API_KEY=your_agentrouter_api_key_here
AGENTROUTER_BASE_URL=https://agentrouter.org
AGENTROUTER_MODEL=gpt-5.6-sol

# ── Fallback 1: Local Ollama (llama3.2:3b) ──────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Fallback 2: Google Gemini (Free tier) ───────────────────────────────────
GEMINI_API_KEY=

# ── Fallback 3: Groq (llama-3.1-8b-instant) ─────────────────────────────────
GROQ_API_KEY=

# ── App & Server Settings ───────────────────────────────────────────────────
LOG_LEVEL=INFO
